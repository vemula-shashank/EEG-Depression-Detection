        np.save(os.path.join(SAVE_PATH, 'y_epoch_checkpoint.npy'), np.array(y_all))
        elapsed_total = (time.time() - start_total) / 60
        remaining = (elapsed_total / (idx+1)) * (total - idx - 1)
        print(f"\nCheckpoint saved | Elapsed: {elapsed_total:.1f} min | Remaining: {remaining:.1f} min\n", flush=True)

