import time
import sys

subject_ids = labels_df['participant_id'].values
total       = len(subject_ids)
X_all       = []
y_all       = []
failed      = []

print("Starting epoch level extraction for", total, "subjects", flush=True)
print("15 epochs per subject", flush=True)
print("Expected time: 35-45 minutes", flush=True)
print("-" * 50, flush=True)

start_total = time.time()

for idx, sid in enumerate(subject_ids):
    start = time.time()
    try:
        epoch_feats, label = extract_epoch_features(sid)

        if epoch_feats is not None:
            for ef in epoch_feats:
                X_all.append(ef)
                y_all.append(label)

            elapsed = time.time() - start
            print(f"[{idx+1:3d}/{total}] {sid} | {'Depressed' if label==1 else 'Healthy  '} | {elapsed:.1f}s | epochs: {len(epoch_feats)}", flush=True)
        else:
            failed.append(sid)

    except Exception as e:
        failed.append(sid)
        print(f"[{idx+1:3d}/{total}] {sid} failed: {e}", flush=True)

    if (idx + 1) % 20 == 0:
