y_all = np.array(y_all)

np.save(os.path.join(SAVE_PATH, 'X_epoch_features.npy'), X_all)
np.save(os.path.join(SAVE_PATH, 'y_epoch_labels.npy'), y_all)

total_time = (time.time() - start_total) / 60
print("-" * 50, flush=True)
print("Extraction complete", flush=True)
print("X shape :", X_all.shape, flush=True)
print("y shape :", y_all.shape, flush=True)
print("Total samples :", len(X_all), flush=True)
print("Successful :", total - len(failed), flush=True)
