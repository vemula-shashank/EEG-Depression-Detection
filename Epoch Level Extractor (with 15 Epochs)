def compute_alpha(signal, scales):
    signal = signal - np.mean(signal)
    y      = np.cumsum(signal)
    N      = len(signal)
    flucts = []
    for s in scales:
        n_segments = N // s
        if n_segments == 0:
            continue
        rms = []
        for i in range(n_segments):
            segment = y[i*s:(i+1)*s]
            x       = np.arange(s)
            coeffs  = np.polyfit(x, segment, 1)
            trend   = np.polyval(coeffs, x)
            rms.append(np.sqrt(np.mean((segment - trend)**2)))
        flucts.append(np.sqrt(np.mean(np.array(rms)**2)))
    log_scales = np.log2(scales)
    log_F      = np.log2(flucts[:len(log_scales)])
    alpha, _, _, _, _ = stats.linregress(log_scales, log_F)
    return alpha

def compute_band_power(signal, sfreq=256, band=(8, 13)):
    from scipy.signal import welch
    freqs, psd = welch(signal, sfreq, nperseg=min(256, len(signal)))
    idx        = np.logical_and(freqs >= band[0], freqs <= band[1])
    return np.trapz(psd[idx], freqs[idx])

def compute_hjorth(signal):
    diff1      = np.diff(signal)
    diff2      = np.diff(diff1)
    activity   = np.var(signal)
    mobility   = np.sqrt(np.var(diff1) / (activity + 1e-10))
    complexity = np.sqrt(np.var(diff2) / (np.var(diff1) + 1e-10)) / (mobility + 1e-10)
    return mobility, complexity

